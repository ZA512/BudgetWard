BUDGETWARD_IMAGE=ghcr.io/za512/budgetward:latest
APPDATA_PATH=./data
# Obligatoire : clé aléatoire d'au moins 24 caractères, utilisée pour se connecter.
BUDGETWARD_ADMIN_TOKEN=
PUID=1000
PGID=1000
BIND_ADDRESS=127.0.0.1
PORT=8010
# Activer derrière un reverse proxy HTTPS.
BUDGETWARD_SECURE_COOKIE=false
# Optionnel : connexion bancaire, voir docs/WOOB.md.
BUDGETWARD_BANK_WEBSITE=
# Utiliser des apostrophes pour préserver les caractères $ et # et les zéros initiaux.
BUDGETWARD_BANK_LOGIN=''
BUDGETWARD_BANK_PASSWORD=''
