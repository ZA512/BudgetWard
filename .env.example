BUDGETWARD_IMAGE=ghcr.io/za512/budgetward:latest
APPDATA_PATH=./data
ADMIN_TOKEN_FILE=./secrets/admin_token
PUID=1000
PGID=1000
BIND_ADDRESS=127.0.0.1
PORT=8010
# Activer derrière un reverse proxy HTTPS.
BUDGETWARD_SECURE_COOKIE=false
# Optionnel : domaine de votre caisse ; identifiants via les fichiers secrets du guide WOOB.md.
BUDGETWARD_BANK_WEBSITE=
# Uniquement avec compose.bank.yaml ; contenu jamais dans les variables d’environnement.
BANK_LOGIN_FILE=./secrets/bank_login
BANK_PASSWORD_FILE=./secrets/bank_password
